---
// VoxDemo — live interactive voxel scene for docs pages
// Usage in MDX:
//   <VoxDemo id="camera-demo" model="apple"
//     controls='["zoom","rotX","rotY","pan","tilt","perspective","interactive","animate"]'
//     defaults='{"zoom":0.65,"rotX":65,"rotY":45,"showFloor":true}' />

import fs from 'fs';

interface Props {
  id: string;
  model?: string;
  voxels?: string;
  controls?: string;
  defaults?: string;
}

const { id, model, voxels: voxelsProp, controls, defaults } = Astro.props;

let resolvedVoxels = voxelsProp;
if (model && !voxelsProp) {
  try {
    const filePath = new URL(`../../public/gallery/${model}.json`, import.meta.url).pathname;
    resolvedVoxels = fs.readFileSync(filePath, 'utf-8');
  } catch {
    resolvedVoxels = '[]';
  }
}
---

<div class="vox-demo" id={id} data-voxels={resolvedVoxels} data-controls={controls} data-defaults={defaults}>
  <div class="vox-demo__viewer">
    <div class="vox-demo__canvas">
      <div class="vox-demo__camera">
        <div class="vox-demo__scene"></div>
      </div>
    </div>
    <div class="vox-demo__controls"></div>
  </div>
  <div class="vox-demo__code">
    <pre class="vox-demo__snippet"><code></code></pre>
  </div>
</div>

<style is:global>
  .vox-demo {
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-gray-5, rgba(255,255,255,0.08));
    border-radius: 12px;
    overflow: hidden;
    background: #0b0f14;
  }
  .vox-demo__viewer {
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 320px;
  }
  .vox-demo__canvas {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    background: #01030a;
  }
  .vox-demo__camera,
  .vox-demo__scene {
    width: 100%;
    height: 100%;
    min-height: 320px;
  }
  .vox-demo__controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    background: #11141a;
    border-left: 1px solid rgba(255,255,255,0.06);
    min-width: 200px;
    max-width: 240px;
    font-family: Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
    font-size: 13px;
    overflow-y: auto;
    max-height: 400px;
  }
  .vox-demo__controls label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: #e2e8f0;
  }
  .vox-demo__controls .range-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #cbd5e1;
  }
  .vox-demo__controls .range-value {
    color: #f8fafc;
    font-weight: 600;
  }
  .vox-demo__controls input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: #334155;
    border: 1px solid #3f4c62;
    padding: 0;
    outline: none;
  }
  .vox-demo__controls input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #94a3b8;
    border: 1px solid #94a3b8;
    cursor: pointer;
  }
  .vox-demo__controls input[type="range"]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #94a3b8;
    border: 1px solid #94a3b8;
    cursor: pointer;
  }
  .vox-demo__controls .switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: #cbd5e1;
    font-size: 13px;
  }
  .vox-demo__controls .switch input:not(:checked) + span {
    color: #64748b;
  }
  .vox-demo__code {
    border-top: 1px solid rgba(255,255,255,0.06);
    max-height: 260px;
    overflow: auto;
  }
  .vox-demo__snippet {
    margin: 0 !important;
    padding: 14px 16px !important;
    background: #000 !important;
    border-radius: 0 !important;
    font-size: 13px !important;
    line-height: 1.5 !important;
  }
  .vox-demo__snippet code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace !important;
    color: #e5e9f0 !important;
    white-space: pre !important;
    background: none !important;
    padding: 0 !important;
  }
  @media (max-width: 768px) {
    .vox-demo__viewer {
      grid-template-columns: 1fr;
    }
    .vox-demo__controls {
      max-width: none;
      border-left: none;
      border-top: 1px solid rgba(255,255,255,0.06);
      max-height: none;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .vox-demo__controls label {
      flex: 1 1 45%;
    }
  }
</style>

<script>
  async function initVoxDemos() {
    const lib = await import("@layoutit/voxcss");

    document.querySelectorAll(".vox-demo").forEach((el) => {
      const id = el.id;
      const voxelsData = el.getAttribute("data-voxels");
      const controlsData = el.getAttribute("data-controls");
      const defaultsData = el.getAttribute("data-defaults");

      let voxels: any[] = [];
      try { voxels = JSON.parse(voxelsData || "[]"); } catch {}

      let controlList: string[] = [];
      try { controlList = JSON.parse(controlsData || "[]"); } catch {}

      let defaults: Record<string, any> = {};
      try { defaults = JSON.parse(defaultsData || "{}"); } catch {}

      const cameraEl = el.querySelector(".vox-demo__camera") as HTMLElement;
      const sceneEl = el.querySelector(".vox-demo__scene") as HTMLElement;
      const canvasEl = el.querySelector(".vox-demo__canvas") as HTMLElement;
      const controlsEl = el.querySelector(".vox-demo__controls") as HTMLElement;
      const codeEl = el.querySelector(".vox-demo__snippet code") as HTMLElement;

      if (!cameraEl || !sceneEl || !canvasEl) return;

      // State
      const state: Record<string, any> = {
        zoom: defaults.zoom ?? 0.65,
        pan: defaults.pan ?? 0,
        tilt: defaults.tilt ?? 0,
        rotX: defaults.rotX ?? 65,
        rotY: defaults.rotY ?? 45,
        perspective: defaults.perspective ?? 8000,
        perspectiveEnabled: defaults.perspectiveEnabled !== false,
        interactive: defaults.interactive !== false,
        animate: defaults.animate ?? false,
        showFloor: defaults.showFloor ?? false,
        showWalls: defaults.showWalls ?? false,
        rows: defaults.rows,
        cols: defaults.cols,
        depth: defaults.depth,
        projection: defaults.projection ?? "cubic",
        mergeVoxels: defaults.mergeVoxels ?? false,
      };

      // Create renderer
      const camera = lib.createCamera({
        element: cameraEl,
        zoom: state.zoom,
        rotX: state.rotX,
        rotY: state.rotY,
        pan: state.pan,
        tilt: state.tilt,
        perspective: state.perspectiveEnabled ? state.perspective : false,
        interactive: state.interactive,
        animate: state.animate ? { axis: "y" as const, speed: 0.3, pauseOnInteraction: true } : false,
      });

      const sceneOpts: any = {
        element: sceneEl,
        voxels,
        showFloor: state.showFloor,
        showWalls: state.showWalls,
        projection: state.projection,
        mergeVoxels: state.mergeVoxels,
      };
      if (state.rows != null) sceneOpts.rows = state.rows;
      if (state.cols != null) sceneOpts.cols = state.cols;
      if (state.depth != null) sceneOpts.depth = state.depth;

      const scene = lib.createScene(sceneOpts);
      const handle = lib.renderScene({ element: canvasEl, camera, scene });

      function updateCamera() {
        camera.update({
          zoom: state.zoom,
          pan: state.pan,
          tilt: state.tilt,
          rotX: state.rotX,
          rotY: state.rotY,
          perspective: state.perspectiveEnabled ? state.perspective : false,
          interactive: state.interactive,
          animate: state.animate ? { axis: "y" as const, speed: 0.3, pauseOnInteraction: true } : false,
        });
        updateCode();
      }

      function updateScene() {
        const opts: any = {
          voxels,
          showFloor: state.showFloor,
          showWalls: state.showWalls,
          projection: state.projection,
          mergeVoxels: state.mergeVoxels,
        };
        if (state.rows != null) opts.rows = state.rows;
        if (state.cols != null) opts.cols = state.cols;
        if (state.depth != null) opts.depth = state.depth;
        handle.setScene(opts);
        updateCode();
      }

      function updateCode() {
        if (!codeEl) return;
        const camProps: string[] = [];
        if (state.zoom !== 0.65) camProps.push(`  zoom: ${state.zoom.toFixed(2)},`);
        if (state.pan !== 0) camProps.push(`  pan: ${state.pan},`);
        if (state.tilt !== 0) camProps.push(`  tilt: ${state.tilt},`);
        if (state.rotX !== 65) camProps.push(`  rotX: ${state.rotX},`);
        if (state.rotY !== 45) camProps.push(`  rotY: ${state.rotY},`);
        if (!state.perspectiveEnabled) camProps.push(`  perspective: false,`);
        else if (state.perspective !== 8000) camProps.push(`  perspective: ${state.perspective},`);
        if (state.interactive) camProps.push(`  interactive: true,`);
        if (state.animate) camProps.push(`  animate: { axis: "y", speed: 0.3 },`);

        const sceneProps: string[] = [];
        sceneProps.push(`  voxels,`);
        if (state.rows != null) sceneProps.push(`  rows: ${state.rows},`);
        if (state.cols != null) sceneProps.push(`  cols: ${state.cols},`);
        if (state.depth != null) sceneProps.push(`  depth: ${state.depth},`);
        if (state.showFloor) sceneProps.push(`  showFloor: true,`);
        if (state.showWalls) sceneProps.push(`  showWalls: true,`);
        if (state.projection !== "cubic") sceneProps.push(`  projection: "${state.projection}",`);
        if (state.mergeVoxels) sceneProps.push(`  mergeVoxels: "${state.mergeVoxels}",`);

        const code = `renderScene({\n  camera: {\n${camProps.join("\n")}\n  },\n  scene: {\n${sceneProps.join("\n")}\n  },\n});`;
        codeEl.textContent = code;
      }

      // Build controls
      const controlDefs: Record<string, () => HTMLElement> = {
        zoom: () => makeRange("zoom", 0.1, 2, 0.01, state.zoom, (v) => { state.zoom = v; updateCamera(); }),
        pan: () => makeRange("pan", -200, 200, 1, state.pan, (v) => { state.pan = v; updateCamera(); }, "px"),
        tilt: () => makeRange("tilt", -200, 200, 1, state.tilt, (v) => { state.tilt = v; updateCamera(); }, "px"),
        rotX: () => makeRange("rotX", 10, 90, 1, state.rotX, (v) => { state.rotX = v; updateCamera(); }, "°"),
        rotY: () => makeRange("rotY", 0, 360, 1, state.rotY, (v) => { state.rotY = v; updateCamera(); }, "°"),
        perspective: () => makeRange("perspective", 500, 12000, 500, state.perspective, (v) => { state.perspective = v; updateCamera(); }, "px"),
        interactive: () => makeSwitch("interactive", state.interactive, (v) => { state.interactive = v; updateCamera(); }),
        animate: () => makeSwitch("animate", state.animate, (v) => { state.animate = v; updateCamera(); }),
        showFloor: () => makeSwitch("show floor", state.showFloor, (v) => { state.showFloor = v; updateScene(); }),
        showWalls: () => makeSwitch("show walls", state.showWalls, (v) => { state.showWalls = v; updateScene(); }),
        rows: () => makeRange("rows", 4, 18, 1, state.rows ?? 8, (v) => { state.rows = v; updateScene(); }),
        cols: () => makeRange("cols", 4, 18, 1, state.cols ?? 8, (v) => { state.cols = v; updateScene(); }),
        depth: () => makeRange("depth", 1, 10, 1, state.depth ?? 6, (v) => { state.depth = v; updateScene(); }),
        projection: () => makeSwitch("dimetric", state.projection === "dimetric", (v) => { state.projection = v ? "dimetric" : "cubic"; updateScene(); }),
        mergeVoxels: () => makeSwitch("merge 3d", state.mergeVoxels === "3d", (v) => { state.mergeVoxels = v ? "3d" : false; updateScene(); }),
      };

      for (const key of controlList) {
        const maker = controlDefs[key];
        if (maker) controlsEl.appendChild(maker());
      }

      if (controlList.length === 0) {
        controlsEl.style.display = "none";
        (el.querySelector(".vox-demo__viewer") as HTMLElement).style.gridTemplateColumns = "1fr";
      }

      updateCode();

      function makeRange(label: string, min: number, max: number, step: number, initial: number, onChange: (v: number) => void, unit = ""): HTMLElement {
        const wrapper = document.createElement("label");
        const heading = document.createElement("span");
        heading.className = "range-heading";
        const nameSpan = document.createElement("span");
        nameSpan.textContent = label;
        const valueSpan = document.createElement("span");
        valueSpan.className = "range-value";
        const fmt = (v: number) => step < 1 ? v.toFixed(2) : String(Math.round(v));
        valueSpan.textContent = fmt(initial) + unit;
        heading.append(nameSpan, valueSpan);

        const input = document.createElement("input");
        input.type = "range";
        input.min = String(min);
        input.max = String(max);
        input.step = String(step);
        input.value = String(initial);
        input.addEventListener("input", () => {
          const v = parseFloat(input.value);
          valueSpan.textContent = fmt(v) + unit;
          onChange(v);
        });

        wrapper.append(heading, input);
        return wrapper;
      }

      function makeSwitch(label: string, initial: boolean, onChange: (v: boolean) => void): HTMLElement {
        const wrapper = document.createElement("label");
        wrapper.className = "switch";
        const input = document.createElement("input");
        input.type = "checkbox";
        input.checked = initial;
        input.addEventListener("change", () => onChange(input.checked));
        const span = document.createElement("span");
        span.textContent = label;
        wrapper.append(input, span);
        return wrapper;
      }
    });
  }

  initVoxDemos();
</script>
